# Copy to .env.local. Everything is optional for local development.

# Database. Local default is a SQLite file. For production use Turso (libsql):
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/crate.db
DATABASE_AUTH_TOKEN=

# Signs session cookies. Set a long random string in production.
SESSION_SECRET=

# Public base URL, used for invite links and the iOS Shortcut recipe.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Claude API for agent notes and recaps. Without it, templated notes are used.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5

# Optional: Last.fm API key for the "On repeat" strip in Memory.
LASTFM_API_KEY=

# ---- Connected sources (each optional). The maker can paste these on /setup in the app instead;
#      values saved in the app win over these. ----

# Spotify: developer.spotify.com/dashboard → Create app → Redirect URI must be exactly
#   http://127.0.0.1:3000/api/connect/spotify/callback   (local)  or  https://<your-domain>/api/connect/spotify/callback
# Add each person who will connect under "User Management" (Development Mode allows 5).
SPOTIFY_CLIENT_ID=
# Optional override; defaults to NEXT_PUBLIC_APP_URL with localhost → 127.0.0.1
SPOTIFY_REDIRECT_URI=

# YouTube: console.cloud.google.com → APIs & Services → enable "YouTube Data API v3" →
#   Credentials → OAuth client (Web application) → Authorized redirect URI:
#   http://localhost:3000/api/connect/youtube/callback
# Add yourself and Ariel as test users on the OAuth consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Music (needs an Apple Developer account): Certificates, IDs & Profiles → Keys → new key with
# MusicKit enabled → download the .p8. Paste its contents with \n for newlines.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# SoundCloud (needs an approved API app): redirect http://localhost:3000/api/connect/soundcloud/callback
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Lets a scheduler hit GET /api/cron/sync?key=... to sync everyone (the app also syncs itself on open).
CRON_SECRET=
